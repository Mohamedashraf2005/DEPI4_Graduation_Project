# ─────────────────────────────────────────────────────────────
#  رقيب · Raqib — Environment configuration
#  Copy this file to ".env" and fill in your FastAPI endpoints.
# ─────────────────────────────────────────────────────────────

# Base URL of your FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Toggle mock mode. While TRUE the UI runs fully on local mock data
# (no backend needed). Set to "false" once your FastAPI is connected.
VITE_USE_MOCK=true

# ── Per-model inference endpoints (Computer Vision) ──────────────
# These are the slots where you plug in your own trained models.
VITE_MODEL_SIGN_DEFECT_URL=/models/sign-defect/infer
VITE_MODEL_POTHOLE_URL=/models/pothole/infer
VITE_MODEL_ACCIDENT_URL=/models/accident/infer

# ── Road risk prediction (ML) ───────────────────────────────────
VITE_MODEL_RISK_URL=/models/risk/predict

# ── RAG assistant ───────────────────────────────────────────────
VITE_RAG_QUERY_URL=/rag/query
